rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: users can read/write their own data; admins can manage all
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid in ['admin']);
      allow delete: if request.auth != null && request.auth.uid in ['admin'];
    }

    // Products: public read, authenticated write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Orders: users can read their own orders, admins can read all; authenticated write
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid in ['admin']);
      allow write: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid in ['admin'];
    }

    // Banners: public read, authenticated write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Default: no access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}